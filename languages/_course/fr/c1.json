    {
      "id": "fr.c1.subjonctif-imparfait-plus-que-parfait-litteraire",
      "fromLesson": 1,
      "why": "B2 gives the past subjunctive and the sequence of tenses; the literary forms are a spelling of them"
    },
    {
      "id": "fr.c1.passe-simple-production",
      "fromLesson": 1,
      "why": "B2 teaches the passe simple to read; C1 writes it, over the same verbs"
    },
    {
      "id": "fr.c1.inversion-registre-soutenu",
      "fromLesson": 1,
      "why": "peut-etre is B1 lesson 6 and ainsi B2 lesson 1, which is what the inversion follows"
    },
    {
      "id": "fr.c1.nuances-subjonctif-indicatif-jugement",
      "fromLesson": 1,
      "why": "the contrast is between two moods the course already teaches, over the B1 verbs of opinion and doubt"
    },
    {
      "id": "fr.c1.dislocation-emphase",
      "fromLesson": 1,
      "why": "a left or right dislocation of taught words plus the A2 tonic pronouns"
    },
    {
      "id": "fr.c1.connecteurs-argumentatifs-registre",
