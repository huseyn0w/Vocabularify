{
  "level": "b2",
  "target": "en",
  "grammarSchedule": [
    {
      "id": "en.b2.present-perfect-full-range",
      "fromLesson": 1,
      "why": "Still, not, and the present perfect auxiliary are all pre-B2 vocabulary, so 'He still hasn't called' and negative questions work from lesson 1."
    },
    {
      "id": "en.b2.future-perfect-simple",
      "fromLesson": 1,
      "why": "Will and have are pre-B2, so 'I will have finished' needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.future-perfect-continuous",
      "fromLesson": 1,
      "why": "Will, have, been and -ing verbs are all pre-B2, so the full form is writable from lesson 1."
    },
    {
      "id": "en.b2.future-continuous-questions-politeness",
      "fromLesson": 1,
      "why": "Will and be are pre-B2; 'Will you be using the car?' needs no B2 vocabulary."
    },
    {
      "id": "en.b2.future-expressions-be",
      "fromLesson": 1,
      "why": "About (A2) and due (B1) are already taught, so about to / due to / be to are all writable from lesson 1."
    },
    {
      "id": "en.b2.passive-full-tense-range",
      "fromLesson": 1,
      "why": "Be, have, must and past participles of common verbs are pre-B2, so the extended passive range needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.passive-ditransitive",
      "fromLesson": 1,
      "why": "Give (A1), sell (A2) and offer (B1) are already taught, so 'She was given a prize' works from lesson 1."
    },
    {
      "id": "en.b2.causative-get-have",
      "fromLesson": 1,
      "why": "Get, have, and cut are pre-B2 (lesson 1: 'I had my hair cut'), so the causative needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.wish-if-only",
      "fromLesson": 1,
      "why": "Wish (A2), if and only (A1) are already taught, so wish/if only sentences work from lesson 1."
    },
    {
      "id": "en.b2.past-perfect-explanatory",
      "fromLesson": 1,
      "why": "Because (A1) and never (A1) are pre-B2, so the explanatory and dramatic-inversion patterns need no new B2 vocabulary."
    },
    {
      "id": "en.b2.inversion-negative-adverbials",
      "fromLesson": 1,
      "why": "Never (A1) and rarely (B1) are pre-B2, and 'not only' is built from not+only (A1), so fronted inversion works from lesson 1."
    },
    {
      "id": "en.b2.relative-whose-preposition",
      "fromLesson": 1,
      "why": "Whom (A2) and which (A1) are pre-B2, so 'the woman to whom I spoke' needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.cleft-pseudo",
      "fromLesson": 1,
      "why": "Thing (A2), reason (B1), problem (A2) and what (A1) are pre-B2, so pseudo-clefts work from lesson 1."
    },
    {
      "id": "en.b2.comparative-superlative-formal",
      "fromLesson": 1,
      "why": "Far (A2) and enough (A2) are pre-B2, so by far and enough+to-infinitive need no new B2 vocabulary."
    },
    {
      "id": "en.b2.little-few",
      "fromLesson": 1,
      "why": "Little and few are both A1, so this needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.uncountable-no-article-generic",
      "fromLesson": 1,
      "why": "Music (A2) and television (A1) are pre-B2 uncountables, so generic reference works from lesson 1."
    },
    {
      "id": "en.b2.verb-patterns-meaning-change",
      "fromLesson": 1,
      "why": "Remember, stop and try are all A2, so the to-infinitive/-ing contrast is writable from lesson 1; to regret (lesson 45) adds a fourth verb later."
    },
    {
      "id": "en.b2.verb-ing-own-subject",
      "fromLesson": 1,
      "why": "To imagine (B1) plus an object pronoun or possessive is pre-B2, so an -ing clause with its own subject works from lesson 1."
    },
    {
      "id": "en.b2.sense-verb-object-ing",
      "fromLesson": 1,
      "why": "See, hear and watch are all pre-B2 (A1/A2), so sense-verb + object + -ing needs no new B2 vocabulary."
    },
    {
      "id": "en.b2.modal-expressions-be-likely-supposed",
      "fromLesson": 1,
      "why": "Likely (B1) and supposed to (A1) are pre-B2, so two of the three be-expressions work from lesson 1; bound to has no bank entry at any level, so only likely/supposed to can be demonstrated."
    },
    {
      "id": "en.b2.must-obligation-rules-concession",
      "fromLesson": 1,
      "why": "Must is A1, so rule, emphasis and concessive uses all need no new B2 vocabulary."
    },
    {
      "id": "en.b2.need-full-modal",
      "fromLesson": 1,
      "why": "Need/to need (A2/B1) are pre-B2, covering both the ordinary-verb and bare-modal uses from lesson 1."
    },
    {
      "id": "en.b2.dare",
      "fromLesson": 2,
      "why": "Dare is a new B2 word placed in lesson 2 alongside the other new function words, so it can be used from lesson 2 on."
    },
    {
      "id": "en.b2.reported-speech-word-order",
      "fromLesson": 1,
      "why": "To say (A1) is pre-B2, so mid/end-position reporting clauses and present-simple citation need no new B2 vocabulary."
    },
    {
      "id": "en.b2.discourse-markers-formal-writing",
      "fromLesson": 5,
      "why": "To summarize (lesson 4) and to conclude (lesson 5) are the B2 words that stand in for compared with/similarly/in conclusion, which the bank does not carry as separate concepts."
    },
    {
      "id": "en.b2.neither-nor-not-only-clauses",
      "fromLesson": 2,
      "why": "Either, neither and nor are new B2 words placed in lesson 2; not only is built from not+only (A1), so the full pattern is available from lesson 2."
    },
    {
      "id": "en.b2.reciprocal-one-another",
      "fromLesson": 1,
      "why": "One another is not a bank concept; each other (B1) is pre-B2, so this topic leans on each other from lesson 1, per the brief."
    },
    {
      "id": "en.b2.reflexive-intensifying",
      "fromLesson": 1,
      "why": "It (A1) and self (A2) are pre-B2, giving 'itself' from lesson 1; the bank has no standalone 'itself' entry, only 'self'."
    },
    {
      "id": "en.b2.negation-emphasis-fronting",
      "fromLesson": 1,
      "why": "Not, all and every are pre-B2 (A1/A2), so emphatic and partial negation need no new B2 vocabulary."
    },
    {
      "id": "en.b2.phrasal-prepositional-stranding",
      "fromLesson": 1,
      "why": "Who (A1), to talk (A1) and to tell (A1) are pre-B2, so stranded prepositions in relative/wh-clauses work from lesson 1."
    },
    {
      "id": "en.b2.possessive-double",
      "fromLesson": 1,
      "why": "Friend (A1) and his (A1, which doubles as a possessive pronoun) are pre-B2; the bank has no dedicated mine/yours/hers, so 'a friend of his' carries this topic from lesson 1."
    },
    {
      "id": "en.b2.quantifier-pronouns-each-several-neither",
      "fromLesson": 2,
      "why": "Each and several (A1) and enough (A2) are pre-B2, but neither is a new B2 word placed in lesson 2, so the full quartet is available from lesson 2."
    },
    {
      "id": "en.b2.article-the-more-the-more",
      "fromLesson": 1,
      "why": "The more (B1) is already taught as its own concept, so the paired comparative needs no new B2 vocabulary."
    }
  ],
